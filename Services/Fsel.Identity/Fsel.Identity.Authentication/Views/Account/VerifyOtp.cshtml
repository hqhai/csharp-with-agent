@model Fsel.Identity.Domain.Models.CommandModels.Quickstarts.VerifyOtpModel
@using Fsel.Identity.Authentication.Quickstart.Account;

@{
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
    // ViewData["Title"] = "Register";
}

@section styles {
    <link rel="stylesheet" href="~/assets/css/pages/verify-otp.css" />
}

<div class="all-content">
    <div class="content">
        <div class="langs">
            @await Component.InvokeAsync("Languages")
        </div>

        <img src="/assets/img/fsel-logo.svg" alt="fsel-logo" class="logo" />
        @if (Model.Type == nameof(AccountController.Register))
        {
            <h1 class="title">Verify OTP</h1>
        }
        else
        {
            <h1 class="title">Forgot password</h1>
        }

        <form id="form-VerifyOtp" asp-route="VerifyOtp">
            @if (Model.Type == nameof(AccountController.Register))
            {
                <p class="sub-title sub-verify-otp">
                    Để đăng ký thành công, vui lòng kiểm tra Email đăng ký của bạn và xác thực OTP
                </p>
            }
            else
            {
                <p class="sub-title"></p>
            }

            <input type="hidden" asp-for="ReturnUrl" />
            <input type="hidden" asp-for="Type" />
            @Html.AntiForgeryToken()

            <div>
                <div class="number-list">
                    <input @* onkeydown="moveToNext(event, this, 'otp-1', 'otp-2')"
                           onpaste="autoFill(event, this)" *@
                           class="number-item"
                           type="password"
                           onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                           required
                           maxlength="1"
                           id="otp-1"
                           autocomplete="off"
                           name="otp-1" />
                    <input @* onkeydown="moveToNext(event, this, 'otp-1', 'otp-3')"
                           onpaste="autoFill(event, this)" *@
                           id="otp-2"
                           class="number-item"
                           type="password"
                           onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                           required
                           maxlength="1"
                           name="otp-2" />
                    <input id="otp-3"
                    @* onkeydown="moveToNext(event, this, 'otp-2', 'otp-4')"
                           onpaste="autoFill(event, this)" *@
                           class="number-item"
                           type="password"
                           onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                           required
                           maxlength="1"
                           autocomplete="off"
                           name="otp-3" />
                    <input id="otp-4"
                    @* onkeydown="moveToNext(event, this, 'otp-3', 'otp-5')"
                           onpaste="autoFill(event, this)" *@
                           class="number-item"
                           type="password"
                           onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                           required
                           maxlength="1"
                           autocomplete="off"
                           name="otp-4" />
                    <input id="otp-5"
                    @* onkeydown="moveToNext(event, this, 'otp-4', 'otp-6')"
                           onpaste="autoFill(event, this)" *@
                           class="number-item"
                           type="password"
                           onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                           required
                           maxlength="1"
                           autocomplete="off"
                           name="otp-5" />
                    <input id="otp-6"
                    @* onkeydown="moveToNext(event, this, 'otp-5', null)"
                           onpaste="autoFill(event, this)" *@
                           class="number-item"
                           type="password"
                           onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                           required
                           maxlength="1"
                           autocomplete="off"
                           name="otp-6" />
                </div>
                <div class="mt-2">
                    <input type="hidden"
                           name="Otp"
                           id="otp"
                           placeholder=" "
                           autocomplete="off"
                           required
                           asp-for="Otp" />
                    @* @Html.ValidationMessageFor(model => model.Otp, "", new { @class = "content-text-danger" }) *@
                </div>
            </div>
            <button type="submit" class="btn">Verify</button>
        </form>

        <div class="resend-otp">
            Didn’t receive a code?
            <a href="@Url.Action("ResendOtp", "Account", new { Model.ReturnUrl, type = Model.Type })">Resend OTP</a>
        </div>
    </div>

    @await Component.InvokeAsync("RightBanner", new { Model.ReturnUrl })

    <partial class="mt-3" name="_ValidationSummary" />
</div>

@section scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");

        <script src="~/assets/js/pages/verify-otp.js"></script>
    }
}

