@model Fsel.Identity.Domain.Models.CommandModels.Quickstarts.VerifyOtpModel

@{
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
    // ViewData["Title"] = "Register";
}

@section styles {
    <link rel="stylesheet" href="~/assets/css/pages/verify-otp.css" />
}

<img src="/assets/img/fsel-logo.svg" alt="fsel-logo" class="logo" />

<h1 class="title">Verify OTP</h1>

<p class="sub-title sub-verify-otp">
    Để đăng ký thành công, vui lòng kiểm tra Email đăng ký của bạn và xác
    thực OTP
</p>

<form asp-route="VerifyOtp">
    <input type="hidden" asp-for="ReturnUrl" />
    <input type="hidden" asp-for="Type" />
    @Html.AntiForgeryToken()

    <div>
        <div class="float-input">
            <input class="text-input"
                   type="text"
                   name="Otp"
                   id="otp"
                   placeholder=" "
                   autocomplete="off"
                   required
                   asp-for="Otp" />
            <label for="Otp" class="input-label">Otp</label>
        </div>
        @Html.ValidationMessageFor(model => model.Otp, "", new { @class = "text-danger" })
    </div>
    @* <div class="number-list">
        <input onkeyup="moveToNext(this, 'otp-2')"
               class="number-item number-item--fail"
               type="text"
               onkeypress="return event.charCode >= 48 && event.charCode <= 57"
               required
               maxlength="1"
               id="otp-1"
               autocomplete="off" />
        <input onkeyup="moveToNext(this, 'otp-3')"
               id="otp-2"
               class="number-item number-item--fail"
               type="text"
               onkeypress="return event.charCode >= 48 && event.charCode <= 57"
               required
               maxlength="1" />
        <input id="otp-3"
               onkeyup="moveToNext(this, 'otp-4')"
               class="number-item number-item--fail"
               type="text"
               onkeypress="return event.charCode >= 48 && event.charCode <= 57"
               required
               maxlength="1"
               autocomplete="off" />
        <input id="otp-4"
               onkeyup="moveToNext(this, 'otp-5')"
               class="number-item number-item--fail"
               type="text"
               onkeypress="return event.charCode >= 48 && event.charCode <= 57"
               required
               maxlength="1"
               autocomplete="off" />
        <input id="otp-5"
               onkeyup="moveToNext(this, 'otp-6')"
               class="number-item number-item--fail"
               type="text"
               onkeypress="return event.charCode >= 48 && event.charCode <= 57"
               required
               maxlength="1"
               autocomplete="off" />
        <input id="otp-6"
               onkeyup="moveToNext(this, null)"
