@using System.Web
@using Fsel.Identity.Authentication.OpenId
@inject Microsoft.Extensions.Localization.IStringLocalizer Localizer
@model Fsel.Identity.Domain.Models.CommandModels.OpenId.UserRegisterModel

@{
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
    var months = string.Join(",", new[] { "i18n_Jan", "i18n_Feb", "i18n_Mar", "i18n_Apr", "i18n_May", "i18n_Jun", "i18n_Jul", "i18n_Aug", "i18n_Sep", "i18n_Oct", "i18n_Nov", "i18n_Dec" }
                    .Select(x => Localizer[x].ToString()));
    var isShowVerifyOtp = (Model.IsShowVerifyOtp.HasValue && Model.IsShowVerifyOtp.Value) ? nameof(Model.IsShowVerifyOtp) : string.Empty;

    // ViewData["Title"] = "Register";
}

@section meta {
    @* <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="-1" /> *@
}

@section styles {
    <link rel="stylesheet" href="~/assets/css/pages/sign-up.css" />
    <link href="~/lib/daterangepicker/css/daterangepicker.css" rel="stylesheet" />
    <link href="~/lib/flatpickr/css/flatpickr.min.css" rel="stylesheet" />
    <link href="~/lib/flatpickr/css/custom.css" rel="stylesheet" />
}

<div class="all-content">
    <div class="content">
        <div class="langs">
            @await Component.InvokeAsync("Languages")
        </div>

        <img src="/assets/img/fsel-logo.svg" alt="fsel-logo" class="logo" />
        <form id="form-Register" asp-route="Register">
            <input type="hidden" asp-for="ReturnUrl" />
            <input type="hidden" name="IsShowVerifyOtp" value="@isShowVerifyOtp" />
            @Html.AntiForgeryToken()

            <!-- What’s your email? section -->
            <div class="section-survey step-2 active">
                <div class="row lastname-and-name">
                    <div class="col-sm-6">
                        <div class="float-input float-input-validate">
                            <input class="text-input"
                                   type="text"
                                   name="LastName"
                                   id="lastName"
                                   placeholder=""
                                   autocomplete="off"
                                   required
                                   asp-for="LastName" />
                            <label for="LastName" class="input-label">@Localizer["i18nSignUpLabelLastName"]</label>
                        </div>
                        @Html.CustomValidationMessageFor(model => model.LastName, Localizer, "", new { @class = "content-text-danger" })
                    </div>
                    <div class="col-sm-6">
                        <div class="float-input float-input-validate">
                            <input class="text-input"
                                   type="text"
                                   name="FirstName"
                                   id="firstName"
                                   placeholder=""
                                   autocomplete="off"
                                   required
                                   asp-for="FirstName" />
                            <label for="FirstName" class="input-label">@Localizer["i18nSignUpLabelFirstName"]</label>
                        </div>
                        @* @Html.Raw(HttpUtility.HtmlDecode(Html.ValidationMessageFor(m => m.FirstName, Localizer, "", new { @class = "content-text-danger" }))) *@
                        @Html.CustomValidationMessageFor(model => model.FirstName, Localizer, "", new { @class = "content-text-danger" })
                    </div>
                </div>
               @*  <div class="row">
                    <div class="col-sm-12">
                        <div class="float-input float-input-validate">
                            <input class="text-input"
                                   type="text"
                                   name="Email"
                                   id="email"
                                   placeholder=""
                                   autocomplete="off"
                                   required
                                   asp-for="Email" />
                            <label for="Email" class="input-label">@Localizer["i18n_email"]</label>
                        </div>
                        @Html.CustomValidationMessageFor(model => model.Email, Localizer, "", new { @class = "content-text-danger" })
                    </div>
                </div> *@
                <div class="row">
                    <div class="col-sm-12">
                        <div class="float-input float-input-validate">
                            <input class="text-input"
                                   type="text"
                                   name="PhoneNumber"
                                   id="phoneNumber"
                                   placeholder=""
                                   autocomplete="off"
                                   required
                                   asp-for="PhoneNumber" />
                            <label for="Email" class="input-label">@Localizer["i18n_phone_number"]</label>
                        </div>
                        @Html.CustomValidationMessageFor(model => model.PhoneNumber, Localizer, "", new { @class = "content-text-danger" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-12">
                        <input type="text" asp-for="BirthdayStr" class="text-input-hidden" readonly />
                        <input type="text" asp-for="Birthday" class="text-input-hidden" readonly />
                        <div class="float-input float-input-validate option-birthday">
                            <div class="name-option">
                                <span>@Localizer["i18nSignUpLabelBirthday"]</span>
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="18"
                                     height="18"
                                     viewBox="0 0 18 18"
                                     fill="none">
                                    <path d="M8.99365 15.5566C12.7312 15.5566 15.8162 12.4717 15.8162 8.74072C15.8162 5.00977 12.7246 1.9248 8.98706 1.9248C5.2561 1.9248 2.17773 5.00977 2.17773 8.74072C2.17773 12.4717 5.2627 15.5566 8.99365 15.5566ZM8.83545 10.0986C8.40698 10.0986 8.16968 9.90088 8.16968 9.50537V9.43286C8.16968 8.81323 8.52563 8.46387 9.01343 8.12109C9.59351 7.71899 9.87695 7.50146 9.87695 7.07959C9.87695 6.62476 9.52759 6.32153 8.98706 6.32153C8.59155 6.32153 8.30151 6.51929 8.08398 6.85547C7.87305 7.09277 7.77417 7.29712 7.37866 7.29712C7.05566 7.29712 6.79199 7.08618 6.79199 6.75659C6.79199 6.62476 6.81836 6.5061 6.8645 6.38745C7.08203 5.74146 7.87305 5.21411 9.05298 5.21411C10.2791 5.21411 11.314 5.8667 11.314 7.01367C11.314 7.80469 10.8789 8.2002 10.1934 8.64185C9.7583 8.92529 9.50781 9.1626 9.48804 9.51855C9.48804 9.53833 9.48145 9.57129 9.48145 9.59766C9.46167 9.8811 9.21777 10.0986 8.83545 10.0986ZM8.82886 12.208C8.38062 12.208 8.01147 11.885 8.01147 11.45C8.01147 11.0149 8.37402 10.6919 8.82886 10.6919C9.2771 10.6919 9.63965 11.0149 9.63965 11.45C9.63965 11.8916 9.27051 12.208 8.82886 12.208Z"
                                          fill="#657990" />
                                </svg>
                            </div>
                            <div class="birthday">
                                <div class="float-input float-input-validate">
                                    <input type="text"
                                           placeholder=""
                                           class="text-input text-input-date"
                                           id="Day"
                                           asp-for="DayBirthday"
                                           name="DayBirthday"
                                           autocomplete="off"
                                           readonly />
                                    <label for="DayBirthday" class="input-label">@Localizer["i18n_day"]</label>
                                    <div class="icon icon-input-date">
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             width="24"
                                             height="24"
                                             viewBox="0 0 24 24"
                                             fill="none">
                                            <path fill-rule="evenodd"
                                                  clip-rule="evenodd"
                                                  d="M5.29289 8.29289C5.68342 7.90237 6.31658 7.90237 6.70711 8.29289L12 13.5858L17.2929 8.2929C17.6834 7.90237 18.3166 7.90237 18.7071 8.2929C19.0976 8.68342 19.0976 9.31659 18.7071 9.70711L12.7071 15.7071C12.3166 16.0976 11.6834 16.0976 11.2929 15.7071L5.29289 9.70711C4.90237 9.31658 4.90237 8.68342 5.29289 8.29289Z"
                                                  fill="#9FB0CB" />
                                        </svg>
                                    </div>
                                    <div class="dropdown-content" id="dayDropdownContent"></div>
                                </div>

                                <div class="float-input float-input-validate">
                                    <input type="hidden" asp-for="MonthBirthday" name="MonthBirthday" id="MonthBirthday" />
                                    <input type="text"
                                           placeholder=""
                                           class="text-input text-input-date"
                                           id="Month"
                                           value="@Model.MonthBirthday"
                                           autocomplete="off"
                                           readonly />
                                    <label for="MonthBirthday" class="input-label">@Localizer["i18n_month"]</label>
                                    <div class="icon icon-input-date">
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             width="24"
                                             height="24"
                                             viewBox="0 0 24 24"
                                             fill="none">
                                            <path fill-rule="evenodd"
                                                  clip-rule="evenodd"
                                                  d="M5.29289 8.29289C5.68342 7.90237 6.31658 7.90237 6.70711 8.29289L12 13.5858L17.2929 8.2929C17.6834 7.90237 18.3166 7.90237 18.7071 8.2929C19.0976 8.68342 19.0976 9.31659 18.7071 9.70711L12.7071 15.7071C12.3166 16.0976 11.6834 16.0976 11.2929 15.7071L5.29289 9.70711C4.90237 9.31658 4.90237 8.68342 5.29289 8.29289Z"
                                                  fill="#9FB0CB" />
                                        </svg>
                                    </div>
                                    <div class="dropdown-content"
                                         id="monthDropdownContent"></div>
                                </div>
                                <div class="MonthBirthday-values hidden" data-values="@months">
                                </div>

                                <div class="float-input float-input-validate">
                                    <input type="text"
                                           placeholder=""
                                           class="text-input text-input-date"
                                           id="Year"
                                           asp-for="YearBirthday"
                                           name="YearBirthday"
                                           autocomplete="off"
                                           readonly />
                                    <label for="YearBirthday" class="input-label">@Localizer["i18n_year"]</label>
                                    <div class="icon icon-input-date">
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             width="24"
                                             height="24"
                                             viewBox="0 0 24 24"
                                             fill="none">
                                            <path fill-rule="evenodd"
                                                  clip-rule="evenodd"
                                                  d="M5.29289 8.29289C5.68342 7.90237 6.31658 7.90237 6.70711 8.29289L12 13.5858L17.2929 8.2929C17.6834 7.90237 18.3166 7.90237 18.7071 8.2929C19.0976 8.68342 19.0976 9.31659 18.7071 9.70711L12.7071 15.7071C12.3166 16.0976 11.6834 16.0976 11.2929 15.7071L5.29289 9.70711C4.90237 9.31658 4.90237 8.68342 5.29289 8.29289Z"
                                                  fill="#9FB0CB" />
                                        </svg>
                                    </div>
                                    <div class="dropdown-content"
                                         id="yearDropdownContent"></div>
                                </div>
                            </div>
                        </div>
                        @Html.CustomValidationMessageFor(model => model.BirthdayStr, Localizer, "", new { @class = "content-text-danger" })
                        @Html.CustomValidationMessageFor(model => model.Birthday, Localizer, "", new { @class = "content-text-danger" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-12">
                        <div class="option-birthday">
                            <div class="name-option">
                                <span>@Localizer["i18nSignUpLabelGender"]</span>
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="18"
                                     height="18"
                                     viewBox="0 0 18 18"
                                     fill="none">
                                    <path d="M8.99365 15.5566C12.7312 15.5566 15.8162 12.4717 15.8162 8.74072C15.8162 5.00977 12.7246 1.9248 8.98706 1.9248C5.2561 1.9248 2.17773 5.00977 2.17773 8.74072C2.17773 12.4717 5.2627 15.5566 8.99365 15.5566ZM8.83545 10.0986C8.40698 10.0986 8.16968 9.90088 8.16968 9.50537V9.43286C8.16968 8.81323 8.52563 8.46387 9.01343 8.12109C9.59351 7.71899 9.87695 7.50146 9.87695 7.07959C9.87695 6.62476 9.52759 6.32153 8.98706 6.32153C8.59155 6.32153 8.30151 6.51929 8.08398 6.85547C7.87305 7.09277 7.77417 7.29712 7.37866 7.29712C7.05566 7.29712 6.79199 7.08618 6.79199 6.75659C6.79199 6.62476 6.81836 6.5061 6.8645 6.38745C7.08203 5.74146 7.87305 5.21411 9.05298 5.21411C10.2791 5.21411 11.314 5.8667 11.314 7.01367C11.314 7.80469 10.8789 8.2002 10.1934 8.64185C9.7583 8.92529 9.50781 9.1626 9.48804 9.51855C9.48804 9.53833 9.48145 9.57129 9.48145 9.59766C9.46167 9.8811 9.21777 10.0986 8.83545 10.0986ZM8.82886 12.208C8.38062 12.208 8.01147 11.885 8.01147 11.45C8.01147 11.0149 8.37402 10.6919 8.82886 10.6919C9.2771 10.6919 9.63965 11.0149 9.63965 11.45C9.63965 11.8916 9.27051 12.208 8.82886 12.208Z"
                                          fill="#657990" />
                                </svg>
                            </div>
                            <div class="option-gender">
                                <input type="hidden" id="gender" value="@(Model.Gender.HasValue ? Model.Gender.Value.ToString() : string.Empty)" />
                                <div class="option">
                                    <input class="round-radio"
                                           type="radio"
                                           asp-for="Gender"
                                           name="gender"
                                           id="male"
                                           value="Male" />
                                    <label for="male" class="round-radio-label">@Localizer["i18n_male"]</label>
                                </div>
                                <div class="option">
                                    <input class="round-radio"
                                           type="radio"
                                           asp-for="Gender"
                                           name="gender"
                                           id="female"
                                           value="Female" />
                                    <label for="female" class="round-radio-label">@Localizer["i18n_female"]</label>
                                </div>
                                <div class="option">
                                    <input class="round-radio"
                                           type="radio"
                                           asp-for="Gender"
                                           name="gender"
                                           id="other"
                                           value="Other" />
                                    <label for="other" class="round-radio-label">@Localizer["i18n_other"]</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-12">
                        <div class="float-input float-input-validate">
                            <input type="checkbox"
                                   id="toggle-password"
                                   class="toggle-password-checkbox"
                                   checked />
                            <label for="toggle-password" class="show-password-icon">
                                <svg width="24"
                                     height="24"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     xmlns="http://www.w3.org/2000/svg">
                                    <path fill-rule="evenodd"
                                          clip-rule="evenodd"
                                          d="M7.5747 17.5702C5.76287 16.6115 4.26766 15.1403 3.28504 13.3521C2.90498 12.6604 2.90499 11.8243 3.28506 11.1328C5.06415 7.89519 8.52347 5.69702 12.5 5.69702C14.5046 5.69702 16.3777 6.25561 17.9704 7.22433L15.2889 9.89298C14.6187 9.10579 13.618 8.60611 12.5 8.60611C10.482 8.60611 8.84616 10.2342 8.84616 12.2425C8.84616 13.3551 9.34823 14.351 10.1392 15.018L7.5747 17.5702ZM9.01115 18.1977C10.1026 18.5799 11.2769 18.7879 12.5 18.7879C16.4766 18.7879 19.9358 16.5897 21.7149 13.3522C22.095 12.6606 22.095 11.8245 21.715 11.1329C21.0709 9.96077 20.2066 8.92489 19.1773 8.08023L16.0108 11.2316C16.104 11.5524 16.1539 11.8916 16.1539 12.2425C16.1539 14.2508 14.518 15.8788 12.5 15.8788C12.1475 15.8788 11.8067 15.8292 11.4842 15.7365L9.01115 18.1977ZM12.5 12.2425L10.9552 13.7905C10.5553 13.3953 10.3077 12.8477 10.3077 12.2425C10.3077 11.0375 11.2893 10.0607 12.5 10.0607C12.9994 10.0607 13.4597 10.2268 13.8283 10.5065L12.5 12.2425Z"
                                          fill="currentcolor" />
                                    <path fill-rule="evenodd"
                                          clip-rule="evenodd"
                                          d="M4.43205 19.787C4.71743 20.071 5.18014 20.071 5.46552 19.787L20.0809 5.24154C20.3663 4.95751 20.3663 4.49703 20.0809 4.21302C19.7955 3.92899 19.3329 3.92899 19.0475 4.21302L4.43205 18.7585C4.14667 19.0425 4.14667 19.503 4.43205 19.787Z"
                                          fill="currentcolor" />
                                </svg>
                            </label>
                            <label for="toggle-password" class="hide-password-icon">
                                <svg width="24"
                                     height="25"
                                     viewBox="0 0 24 25"
                                     fill="none"
                                     xmlns="http://www.w3.org/2000/svg">
                                    <path d="M21.915 12.2145C19.8747 8.71894 16.074 6.55151 12 6.55151C7.92599 6.55151 4.12535 8.71894 2.085 12.2145C1.97167 12.4194 1.97167 12.6705 2.085 12.8753C4.12535 16.3775 7.92599 18.5515 12 18.5515C16.074 18.5515 19.8747 16.3775 21.915 12.8753C22.0283 12.6705 22.0283 12.4194 21.915 12.2145ZM12 16.6815C9.69961 16.6815 7.83263 14.8313 7.83263 12.5515C7.83263 10.2718 9.69961 8.42157 12 8.42157C14.3004 8.42157 16.1674 10.2718 16.1674 12.5515C16.1674 14.8313 14.3004 16.6815 12 16.6815Z"
                                          fill="currentcolor" />
                                    <path d="M12 14.5515C13.1046 14.5515 14 13.6561 14 12.5515C14 11.4469 13.1046 10.5515 12 10.5515C10.8954 10.5515 10 11.4469 10 12.5515C10 13.6561 10.8954 14.5515 12 14.5515Z"
                                          fill="currentcolor" />
                                </svg>
                            </label>
                            <input class="text-input"
                                   type="text"
                                   name="Password"
                                   id="password"
                                   placeholder=""
                                   autocomplete="off"
                                   required
                                   asp-for="Password" />
                            <label for="Password" class="input-label">@Localizer["i18n_password"]</label>
                        </div>
                        @Html.CustomValidationMessageFor(model => model.Password, Localizer, "", new { @class = "content-text-danger" })

                        <div>
                            <div class="meter">
                                <div class="meter-progress meter-progress--strong"
                                     id="passwordMeter"></div>
                                <span class="meter-text" id="meter-text"
                                      text-strong="@Localizer["i18n_Strong"]"
                                      text-good="@Localizer["i18n_Good"]"
                                      text-weak="@Localizer["i18n_Weak"]">
                                </span>
                            </div>
                            <div class="rule-list" id="rule-list">
                                <div class="rule-item rule-item--invalid" id="pass-length">
                                    <img src="/assets/icons/close-icon.svg" alt="" />
                                    <span cal>@Localizer["i18n_at_lest_8_characters"]</span>
                                </div>
                                <div class="rule-item rule-item--invalid" id="pass-number">
                                    <img src="/assets/icons/close-icon.svg" alt="" />
                                    <span>@Localizer["i18n_contains_a_number"]</span>
                                </div>
                                <div class="rule-item rule-item--invalid" id="pass-Up-case">
                                    <img src="/assets/icons/close-icon.svg" alt="" />
                                    <span>@Localizer["i18n_Contains_both_lower_and_uppercase_letters"]</span>
                                </div>
                                <div class="rule-item rule-item--invalid" id="pass-symbo">
                                    <img src="/assets/icons/close-icon.svg" alt="" />
                                    <span>@Localizer["i18n_contains_a_symbol"]</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="checkbox">
                    <input type="checkbox" name="policy" id="policy" hidden checked="checked" />
                    <label for="policy" class="service-policy">
                        @Localizer["i18n_i_agree"] <a target="_blank" href="https://term-condition.fsel.edu.vn">@Localizer["i18n_term_of_services"]</a> @Localizer["i18n_and"]
                        <a target="_blank" href="https://policy.fsel.edu.vn">@Localizer["i18n_privacy_policy"]</a>
                    </label>
                </div>
            </div>

            <button type="submit" class="btn sign-up-btn">
                @Localizer["i18n_sign_up"]
            </button>

            <div class="text-footer">@Localizer["i18n_already_a_member"] <a href="@Url.Action("Login", "Account", new { Model.ReturnUrl })">@Localizer["i18n_login_now"]</a></div>
        </form>
    </div>

    @await Component.InvokeAsync("RightBanner", new { Model.ReturnUrl })

    <partial class="mt-3" name="_ValidationSummary" />
</div>

@section scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        <script src="~/lib/momentjs/js/moment.min.js"></script>
        <script src="~/lib/daterangepicker/js/daterangepicker.min.js"></script>
        <script src="~/lib/flatpickr/js/flatpickr.js"></script>

        <script src="~/assets/js/pages/register.js"></script>
    }
}

