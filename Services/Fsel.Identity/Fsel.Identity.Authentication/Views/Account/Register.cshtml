@model Fsel.Identity.Domain.Models.CommandModels.Quickstarts.UserRegisterModel

@{
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
    // ViewData["Title"] = "Register";
}

@section styles {
    <link rel="stylesheet" href="~/assets/css/pages/sign-up.css" />
    @* <link href="~/lib/daterangepicker/css/daterangepicker.css" rel="stylesheet" /> *@
    <link href="~/lib/flatpickr/css/flatpickr.min.css" rel="stylesheet" />
    <link href="~/lib/flatpickr/css/custom.css" rel="stylesheet" />
}

<div class="back">
<div class="backItem" id="backItem">
    <svg
    xmlns="http://www.w3.org/2000/svg"
    width="22"
    height="22"
    viewBox="0 0 22 22"
    fill="none"
    >
    <path
        fill-rule="evenodd"
        clip-rule="evenodd"
        d="M14.3368 4.96356C14.6883 5.31503 14.6883 5.88488 14.3368 6.23635L9.57318 11L14.3368 15.7636C14.6883 16.115 14.6883 16.6849 14.3368 17.0363C13.9853 17.3878 13.4155 17.3878 13.064 17.0363L7.66399 11.6363C7.31252 11.2849 7.31252 10.715 7.66399 10.3636L13.064 4.96356C13.4155 4.61208 13.9853 4.61208 14.3368 4.96356Z"
        fill="white"
    />
    </svg>
</div>
</div>

<img src="/assets/img/fsel-logo.svg" alt="fsel-logo" class="logo" />
<form id="form-Register" asp-route="Register">
    <input type="hidden" asp-for="ReturnUrl" />
    @Html.AntiForgeryToken()

    <!-- What’s your email? section -->
    <section class="section-survey step-1 active">
        <div class="step-list">
            <div class="step-item step-item--active"></div>
            <div class="step-item"></div>
            <div class="step-item"></div>
            <div class="step-item"></div>
        </div>
        <h1 class="title">What’s your email?</h1>

        @* <div class="role-container">
            <div class="role-item role-item--active">Student</div>
            <div class="role-item">Parent</div>
        </div> *@
        <div>
            <div class="float-input">
                <input class="text-input"
                       type="text"
                       name="Email"
                       id="Email"
                       placeholder=""
                       autocomplete="off"
                       required
                       asp-for="Email" />
                <label for="Email" class="input-label">Email</label>
            </div>
            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
        </div>
    </section>

    <!-- Enter your name section -->
    <section class="section-survey step-2 hidden">
        <div class="step-list">
            <div class="step-item step-item--active"></div>
            <div class="step-item step-item--active"></div>
            <div class="step-item"></div>
            <div class="step-item"></div>
        </div>
        <h1 class="title">Enter your name</h1>

        <div class="row">
            <div class="col-sm-6">
                <div class="float-input">
                    <input class="text-input"
                           type="text"
                           name="LastName"
                           id="LastName"
                           placeholder=""
                           autocomplete="off"
                           required
                           asp-for="LastName" />
                    <label for="LastName" class="input-label">Last name</label>
                </div>
                @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-danger" })
            </div>
            <div class="col-sm-6">
                <div class="float-input">
                    <input class="text-input"
                            type="text"
                            name="FirstName"
                            id="FirstName"
                            placeholder=""
                            autocomplete="off"
                            required
                            asp-for="FirstName" />
                    <label for="FirstName" class="input-label">First name</label>
                </div>
                @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="float-input">
                    <input class="text-input"
                           type="text"
                           max="@(DateTime.Now.ToString("yyyy-MM-dd"))"
                           name="Birthday"
                           id="Birthday"
                           placeholder=""
                           autocomplete="off"
                           asp-for="Birthday" />
                    <label for="Birthday" class="input-label">Birthday</label>
                </div>
                @Html.ValidationMessageFor(model => model.Birthday, "", new { @class = "text-danger" })
            </div>
        </div>
    </section>

    <!-- Choose a Password -->
    <section class="section-survey step-3 hidden">
        <div class="step-list">
            <div class="step-item step-item--active"></div>
            <div class="step-item step-item--active"></div>
            <div class="step-item step-item--active"></div>
            <div class="step-item"></div>
        </div>
        <h1 class="title">Choose a Password</h1>
        <div>
            <div class="float-input">
                <input type="checkbox"
                  id="toggle-password"
                  class="toggle-password-checkbox"
                  checked />
                <label for="toggle-password" class="show-password-icon">
                    <svg width="24"
                         height="24"
                         viewBox="0 0 24 24"
                         fill="none"
                         xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd"
                              clip-rule="evenodd"
                              d="M7.5747 17.5702C5.76287 16.6115 4.26766 15.1403 3.28504 13.3521C2.90498 12.6604 2.90499 11.8243 3.28506 11.1328C5.06415 7.89519 8.52347 5.69702 12.5 5.69702C14.5046 5.69702 16.3777 6.25561 17.9704 7.22433L15.2889 9.89298C14.6187 9.10579 13.618 8.60611 12.5 8.60611C10.482 8.60611 8.84616 10.2342 8.84616 12.2425C8.84616 13.3551 9.34823 14.351 10.1392 15.018L7.5747 17.5702ZM9.01115 18.1977C10.1026 18.5799 11.2769 18.7879 12.5 18.7879C16.4766 18.7879 19.9358 16.5897 21.7149 13.3522C22.095 12.6606 22.095 11.8245 21.715 11.1329C21.0709 9.96077 20.2066 8.92489 19.1773 8.08023L16.0108 11.2316C16.104 11.5524 16.1539 11.8916 16.1539 12.2425C16.1539 14.2508 14.518 15.8788 12.5 15.8788C12.1475 15.8788 11.8067 15.8292 11.4842 15.7365L9.01115 18.1977ZM12.5 12.2425L10.9552 13.7905C10.5553 13.3953 10.3077 12.8477 10.3077 12.2425C10.3077 11.0375 11.2893 10.0607 12.5 10.0607C12.9994 10.0607 13.4597 10.2268 13.8283 10.5065L12.5 12.2425Z"
                              fill="currentcolor" />
                        <path fill-rule="evenodd"
                              clip-rule="evenodd"
                              d="M4.43205 19.787C4.71743 20.071 5.18014 20.071 5.46552 19.787L20.0809 5.24154C20.3663 4.95751 20.3663 4.49703 20.0809 4.21302C19.7955 3.92899 19.3329 3.92899 19.0475 4.21302L4.43205 18.7585C4.14667 19.0425 4.14667 19.503 4.43205 19.787Z"
                              fill="currentcolor" />
                    </svg>
                </label>
                <label for="toggle-password" class="hide-password-icon">
                    <svg width="24"
                         height="25"
                         viewBox="0 0 24 25"
                         fill="none"
                         xmlns="http://www.w3.org/2000/svg">
                        <path d="M21.915 12.2145C19.8747 8.71894 16.074 6.55151 12 6.55151C7.92599 6.55151 4.12535 8.71894 2.085 12.2145C1.97167 12.4194 1.97167 12.6705 2.085 12.8753C4.12535 16.3775 7.92599 18.5515 12 18.5515C16.074 18.5515 19.8747 16.3775 21.915 12.8753C22.0283 12.6705 22.0283 12.4194 21.915 12.2145ZM12 16.6815C9.69961 16.6815 7.83263 14.8313 7.83263 12.5515C7.83263 10.2718 9.69961 8.42157 12 8.42157C14.3004 8.42157 16.1674 10.2718 16.1674 12.5515C16.1674 14.8313 14.3004 16.6815 12 16.6815Z"
                              fill="currentcolor" />
                        <path d="M12 14.5515C13.1046 14.5515 14 13.6561 14 12.5515C14 11.4469 13.1046 10.5515 12 10.5515C10.8954 10.5515 10 11.4469 10 12.5515C10 13.6561 10.8954 14.5515 12 14.5515Z"
                              fill="currentcolor" />
                    </svg>
                </label>
                <input class="text-input"
                       type="text"
                       name="Password"
                       id="Password"
                       placeholder=""
                       autocomplete="off"
                       required
                       pattern=@("^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[@$!%*?&.])[A-Za-z\\d@$!%*?&]{8,}$")
                       asp-for="Password" />
                <label for="Password" class="input-label">New Password</label>
            </div>
            @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })

            <div>
                <div class="meter">
                    <div class="meter-progress meter-progress--strong"
                         id="passwordMeter"></div>
                    <span class="meter-text" id="meter-text"></span>
                </div>
                <div class="rule-list" id="rule-list">
                    <div class="rule-item rule-item--invalid" id="pass-length">
                        <img src="/assets/icons/check-icon.svg" alt="" />
                        <span cal>At least eight characters</span>
                    </div>
                    <div class="rule-item rule-item--invalid" id="pass-number">
                        <img src="/assets/icons/close-icon.svg" alt="" />
                        <span>Contains a number</span>
                    </div>
                    <div class="rule-item rule-item--invalid" id="pass-Up-case">
                        <img src="/assets/icons/close-icon.svg" alt="" />
                        <span>Contains a capital letter</span>
                    </div>
                    <div class="rule-item rule-item--invalid" id="pass-symbo">
                        <img src="/assets/icons/check-icon.svg" alt="" />
                        <span>Contains a symbol</span>
                    </div>
                </div>
            </div>
        </div>

        <div>
            <div class="float-input">
                <input type="checkbox"
                  id="toggle-confirmation-password"
                  class="toggle-password-checkbox"
                  checked />
                <label for="toggle-confirmation-password"
                  class="show-password-icon" >
                    <svg width="24"
                         height="24"
                         viewBox="0 0 24 24"
                         fill="none"
                         xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd"
                              clip-rule="evenodd"
                              d="M7.5747 17.5702C5.76287 16.6115 4.26766 15.1403 3.28504 13.3521C2.90498 12.6604 2.90499 11.8243 3.28506 11.1328C5.06415 7.89519 8.52347 5.69702 12.5 5.69702C14.5046 5.69702 16.3777 6.25561 17.9704 7.22433L15.2889 9.89298C14.6187 9.10579 13.618 8.60611 12.5 8.60611C10.482 8.60611 8.84616 10.2342 8.84616 12.2425C8.84616 13.3551 9.34823 14.351 10.1392 15.018L7.5747 17.5702ZM9.01115 18.1977C10.1026 18.5799 11.2769 18.7879 12.5 18.7879C16.4766 18.7879 19.9358 16.5897 21.7149 13.3522C22.095 12.6606 22.095 11.8245 21.715 11.1329C21.0709 9.96077 20.2066 8.92489 19.1773 8.08023L16.0108 11.2316C16.104 11.5524 16.1539 11.8916 16.1539 12.2425C16.1539 14.2508 14.518 15.8788 12.5 15.8788C12.1475 15.8788 11.8067 15.8292 11.4842 15.7365L9.01115 18.1977ZM12.5 12.2425L10.9552 13.7905C10.5553 13.3953 10.3077 12.8477 10.3077 12.2425C10.3077 11.0375 11.2893 10.0607 12.5 10.0607C12.9994 10.0607 13.4597 10.2268 13.8283 10.5065L12.5 12.2425Z"
                              fill="currentcolor" />
                        <path fill-rule="evenodd"
                              clip-rule="evenodd"
                              d="M4.43205 19.787C4.71743 20.071 5.18014 20.071 5.46552 19.787L20.0809 5.24154C20.3663 4.95751 20.3663 4.49703 20.0809 4.21302C19.7955 3.92899 19.3329 3.92899 19.0475 4.21302L4.43205 18.7585C4.14667 19.0425 4.14667 19.503 4.43205 19.787Z"
                              fill="currentcolor" />
                    </svg>
                </label>
                <label for="toggle-confirmation-password"
                  class="hide-password-icon" >
                    <svg width="24"
                         height="25"
                         viewBox="0 0 24 25"
                         fill="none"
                         xmlns="http://www.w3.org/2000/svg">
                        <path d="M21.915 12.2145C19.8747 8.71894 16.074 6.55151 12 6.55151C7.92599 6.55151 4.12535 8.71894 2.085 12.2145C1.97167 12.4194 1.97167 12.6705 2.085 12.8753C4.12535 16.3775 7.92599 18.5515 12 18.5515C16.074 18.5515 19.8747 16.3775 21.915 12.8753C22.0283 12.6705 22.0283 12.4194 21.915 12.2145ZM12 16.6815C9.69961 16.6815 7.83263 14.8313 7.83263 12.5515C7.83263 10.2718 9.69961 8.42157 12 8.42157C14.3004 8.42157 16.1674 10.2718 16.1674 12.5515C16.1674 14.8313 14.3004 16.6815 12 16.6815Z"
                              fill="currentcolor" />
                        <path d="M12 14.5515C13.1046 14.5515 14 13.6561 14 12.5515C14 11.4469 13.1046 10.5515 12 10.5515C10.8954 10.5515 10 11.4469 10 12.5515C10 13.6561 10.8954 14.5515 12 14.5515Z"
                              fill="currentcolor" />
                    </svg>
                </label>
                <input class="text-input"
                       type="text"
                       name="ConfirmPassword"
                       id="ConfirmPassword"
                       placeholder=""
                       autocomplete="off"
                       required
                       pattern=@("^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[@$!%*?&.])[A-Za-z\\d@$!%*?&]{8,}$")
                       asp-for="ConfirmPassword" />
                <label for="ConfirmPassword" class="input-label">Confirmation Password</label>
            </div>
            @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
        </div>
    </section>

    <!-- Referral code section -->
    <section class="section-survey step-4 hidden">
        <div class="step-list">
            <div class="step-item step-item--active"></div>
            <div class="step-item step-item--active"></div>
            <div class="step-item step-item--active"></div>
            <div class="step-item step-item--active"></div>
        </div>

        <h1 class="title">Referral code</h1>
        <div>
            <div class="float-input">
                <input class="text-input"
                        type="text"
                        name="ReferralCode"
                        id="ReferralCode"
                        placeholder=""
                        autocomplete="off"
                        asp-for="ReferralCode" />
                <label for="ReferralCode" class="input-label">Referral code</label>
            </div>
            @Html.ValidationMessageFor(model => model.ReferralCode, "", new { @class = "text-danger" })
        </div>

        <div class="checkbox">
            <input type="checkbox" name="policy" id="policy" hidden />
            <label for="policy" class="service-policy">
                I agree to the <a> Terms of Service</a> and
                <a>Privacy Policy</a>
            </label>
        </div>
    </section>

    <button type="submit" class="btn sign-up-btn hidden" disabled>
        Sign up
    </button>
</form>
<button class="btn continue-btn" disabled>
    Continue
    <svg width="19"
         height="18"
         viewBox="0 0 19 18"
         fill="none"
         xmlns="http://www.w3.org/2000/svg">
        <g id="Icon">
            <path id="Vector"
                  d="M15.4965 9.28717C15.5329 9.19939 15.5531 9.1032 15.5534 9.00233V8.99783C15.5528 8.80664 15.4796 8.61562 15.3337 8.46975L10.0304 3.16645C9.73752 2.87355 9.26264 2.87355 8.96975 3.16645C8.67686 3.45934 8.67686 3.93421 8.96975 4.22711L12.9927 8.25008L4.19678 8.25008C3.78256 8.25008 3.44678 8.58587 3.44678 9.00008C3.44678 9.41429 3.78256 9.75008 4.19678 9.75008H12.9927L8.96975 13.773C8.67685 14.0659 8.67685 14.5408 8.96975 14.8337C9.26264 15.1266 9.73751 15.1266 10.0304 14.8337L15.3333 9.53078L15.3353 9.52882C15.4064 9.45728 15.4601 9.37497 15.4965 9.28717Z"
                  fill="currentcolor" />
        </g>
    </svg>
</button>

<partial class="mt-3" name="_ValidationSummary" />

<div class="text-footer">Already a member? <a href="/Account/Login">Log in now</a></div>

@section scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        <script src="~/lib/momentjs/js/moment.min.js"></script>
        // <script src="~/lib/daterangepicker/js/daterangepicker.min.js"></script>
        <script src="~/lib/flatpickr/js/flatpickr.js"></script>

        <script src="~/assets/js/pages/register.js"></script>
    }
}

