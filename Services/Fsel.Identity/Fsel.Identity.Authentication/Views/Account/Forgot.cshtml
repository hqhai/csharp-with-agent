@using Fsel.Identity.Authentication.OpenId
@inject Microsoft.Extensions.Localization.IStringLocalizer Localizer
@model Fsel.Identity.Domain.Models.CommandModels.OpenId.ForgotModel

@{
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
    // ViewData["Title"] = "Register";
}

@section styles {
    <link rel="stylesheet" href="~/assets/css/pages/forgot-password-email.css" />
}

<div class="all-content">
    <div class="content">
        <div class="langs">
            @await Component.InvokeAsync("Languages")
        </div>

        <img src="/assets/img/fsel-logo.svg" alt="fsel-logo" class="logo" />
        <h1 class="title">@Localizer["i18n_forgot_password"]</h1>

        <form id="form-Forgot" asp-route="Forgot">
            <input type="hidden" asp-for="ReturnUrl" />
            @Html.AntiForgeryToken()

            <div>
                <div class="float-input float-input-validate">
                    <input class="text-input"
                           type="text"
                           name="Identity"
                           id="identity"
                           placeholder=" "
                           autocomplete="off"
                           required
                           asp-for="Identity" />
                    <label for="identity" class="input-label">@Localizer["i18n_email"]</label>
                </div>
                @Html.CustomValidationMessageFor(model => model.Identity, Localizer, "", new { @class = "content-text-danger" })
            </div>
            <button type="submit" class="btn send-otp-button">@Localizer["i18n_send_otp"]</button>
        </form>
    </div>

    @await Component.InvokeAsync("RightBanner", new { Model.ReturnUrl })

    <partial class="mt-3" name="_ValidationSummary" />
</div>

@section scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        <script src="~/assets/js/pages/forgot.js"></script>
    }
}
