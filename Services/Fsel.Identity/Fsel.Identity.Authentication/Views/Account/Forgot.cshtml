@model Fsel.Identity.Domain.Models.CommandModels.Quickstarts.ForgotModel

@{
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
    // ViewData["Title"] = "Register";
}

@section styles {
    <link rel="stylesheet" href="~/assets/css/pages/forgot-password-email.css" />
}

<div class="all-content">
    <div class="content">
        <div class="langs">
            @await Component.InvokeAsync("Languages")
        </div>

        <img src="/assets/img/fsel-logo.svg" alt="fsel-logo" class="logo" />
        <h1 class="title">Forgot password</h1>

        <form asp-route="Forgot">
            <input type="hidden" asp-for="ReturnUrl" />
            @Html.AntiForgeryToken()

            <div>
                <div class="float-input float-input-validate">
                    <input class="text-input"
                           type="text"
                           name="Email"
                           id="email"
                           placeholder=" "
                           autocomplete="off"
                           required
                           asp-for="Email" />
                    <label for="Email" class="input-label">Email</label>
                </div>
                @Html.ValidationMessageFor(model => model.Email, "", new { @class = "content-text-danger" })
            </div>
            <button type="submit" class="btn send-otp-button">Send OTP</button>
        </form>
    </div>

    @await Component.InvokeAsync("RightBanner")

    <partial class="mt-3" name="_ValidationSummary" />
</div>

@section scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
