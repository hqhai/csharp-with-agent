<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no" />

    <title>Fsel OpenID</title>
    
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" />
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <!-- Fonts -->
    <link rel="stylesheet" href="~/assets/fonts/stylesheet.css" />

    <!-- CSS -->
    <link rel="stylesheet" href="~/assets/css/main.css" />
    <link rel="stylesheet" href="~/assets/css/pages/common.css" />
    @RenderSection("styles", required: false)
</head>
<body>
    @* <partial name="_Nav" /> *@

    <div class="container">
        <div class="language-container" id="languageContainer">
            <div class="language">
                <span class="language_name">Eng</span>
                <img src="/assets/icons/eng-icon.svg" alt="" class="language_image" />
            </div>
            <div id="languageDropdown" class="language-dropdown">
                <div class="language-dropdown-item">
                    <span class="language_name">Vn</span>
                    <img src="/assets/icons/vn-icon.svg" alt="" class="language_image" />
                </div>
            </div>
        </div>

        <div class="content">
            @RenderBody()
        </div>
    </div>

    <div class="loading hidden" @* style="display: none !important" *@>
        <div class="icon-loading">
            <img src="/assets/gif/loading.gif" alt="" />
        </div>
    </div>
   
    @* <div class="container body-container">
        @RenderBody()
    </div> *@

    <script src="~/lib/jquery/dist/jquery.slim.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/main.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
